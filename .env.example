# Export these variables in the server environment; .env is not loaded automatically.
WATERMARK_ADMIN_USER=admin
# Set your own password, at least 12 bytes. No default password is provided.
WATERMARK_ADMIN_PASSWORD=
# Set true when serving over HTTPS (including HTTPS reverse proxies).
WATERMARK_COOKIE_SECURE=false
PORT=8080
# Optional: Go image blind watermark key, exactly 32 bytes encoded as 64 hex characters.
# Generate with ./cli blind-keygen; store securely and reuse for extraction. No default.
WATERMARK_BLIND_KEY=
# Optional durable distribution/key features (both required together; single instance).
# Keep this directory private (0700). Never put real data or secrets in Git.
WATERMARK_DATA_DIR=
# Independent 32-byte hex master key, different from WATERMARK_BLIND_KEY.
# Generate ONCE with ./cli blind-keygen and securely back it up outside the data directory.
WATERMARK_DATA_KEY=
